{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "no-trailing-whitespace": "off",
    "attr-quotes": "error",
    "doctype-html": "error",
    "no-dup-attr": "error",
    "no-dup-id": "error"
  },
  "elements": [
    "html5"
  ]
}
